[Unit]
# Stops AI-coding CLIs from deleting your history, and appends this machine's
# per-session token counts to the append-only ledger.
#
# This exists because the daemon was started by hand with setsid and would have
# died on the next reboot with nothing to say so. A guard you believe is running
# is worse than no guard: you stop checking.
Description=AI transcript retention guard + token ledger
Documentation=file:///home/phantomcore/deadreckon-count/retention_guard.py

[Service]
Type=simple
# ONE daemon, two independent jobs. Set either to 0 to turn that half off
# without touching the other; both default to on if unset. A disabled job says
# so on every tick, because a job that is off and silent is a job you believe
# is working.
#
#   retention  raise cleanupPeriodDays, hard-link every transcript
#   ledger     append this machine's per-session token counts
Environment=RETENTION_GUARD_RETENTION=1
Environment=RETENTION_GUARD_LEDGER=1
# The symlink resolves into the repo, so the service always runs the committed
# code. It used to be a COPY in ~/.local/bin, four hours stale, and that copy is
# what the daemon actually ran.
ExecStart=/usr/bin/python3 /home/phantomcore/.local/bin/retention_guard.py --daemon
Restart=always
RestartSec=60
# A tick that raises must not take the service down with it — the next tick is
# six hours away and the whole point is to be there for it.
# The journal, not a file. `append:` holds ONE fd opened at unit start, so an
# `rm` or `mv` of the log blackholes every tick report, every "NOT ARCHIVED"
# line and every "job ERROR" line, while the unit stays active (running) and the
# recreated file sits at 0 bytes. Verified with a throwaway systemd-run unit
# using the same directives, and confirmed here: journalctl held systemd's own
# start/stop lines and none of the daemon's output.
#
# No data is lost when that happens — all three layers keep working — but what
# it silences is the DETECTOR for every other defect. The journal survives the
# file being deleted, rotates on its own, and is queryable by time.
#
#   journalctl --user -u retention-guard.service -f
#   journalctl --user -u retention-guard.service --since today | grep 'NOT ARCHIVED'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
